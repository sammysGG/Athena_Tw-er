generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  displayName  String
  passwordHash String
  bio          String?
  gender       String?
  location     String?
  website      String?
  avatarUrl    String?
  role         String    @default("user")
  // Orthogonal to role. Visual badge on the author label.
  // "press" | "gov" | "mil" | "state" | "bot" | "ai" | null
  verifiedType String?
  createdAt    DateTime  @default(now())

  posts        Post[]
  likes        Like[]
  comments     Comment[]
  savedPosts   SavedPost[]
  followers    Follow[]      @relation("UserFollowers")
  following    Follow[]      @relation("UserFollows")
  sentMsgs     ChatMessage[] @relation("MessagesSent")
  recvMsgs     ChatMessage[] @relation("MessagesReceived")
  roomsCreated ChatRoom[]    @relation("RoomsCreated")
  roomMessages RoomMessage[] @relation("RoomMessagesSent")
  pollVotes    PollVote[]
  reposts      Repost[]
  postViews    PostView[]
}

model Post {
  id            String    @id @default(cuid())
  content       String
  authorId      String
  mediaUrl      String?
  mediaType     String?
  pinnedAt      DateTime?
  // "post" | "poll" | "question"
  kind          String    @default("post")
  pollExpiresAt DateTime?
  // Admin-applied banner: "disputed" | "state-media" | "ai-generated" |
  // "official" | "satire" | null
  label         String?
  // When set in the future, the post is hidden from the public feed
  // until this timestamp passes. Used for scenario injects.
  scheduledFor  DateTime?
  // Optional reference to the admin who injected this post (when posted
  // on behalf of another user). Display author remains `authorId`.
  injectedById  String?
  createdAt     DateTime  @default(now())

  author        User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes         Like[]
  comments      Comment[]
  savedBy       SavedPost[]
  pollOptions   PollOption[]
  pollVotes     PollVote[]
  reposts       Repost[]
  views         PostView[]

  @@index([createdAt])
  @@index([authorId])
  @@index([pinnedAt])
}

model Repost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model PostView {
  id        String   @id @default(cuid())
  postId    String
  // userId is nullable: anonymous viewers tracked by IP-derived key in `anonKey`.
  userId    String?
  anonKey   String?
  createdAt DateTime @default(now())

  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // One unique view row per (post, user). For anonymous viewers we dedupe
  // on (post, anonKey).
  @@unique([postId, userId])
  @@unique([postId, anonKey])
  @@index([postId])
}

model PollOption {
  id     String     @id @default(cuid())
  postId String
  text   String
  order  Int

  post   Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([postId])
}

model PollVote {
  id        String   @id @default(cuid())
  postId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([optionId])
  @@index([postId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
}

model ChatMessage {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  mediaUrl   String?
  mediaType  String?
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  sender     User @relation("MessagesSent",     fields: [senderId],   references: [id], onDelete: Cascade)
  receiver   User @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
}

model ChatRoom {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())

  createdBy   User          @relation("RoomsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  messages    RoomMessage[]
}

model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  content   String
  mediaUrl  String?
  mediaType String?
  createdAt DateTime @default(now())

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation("RoomMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}
